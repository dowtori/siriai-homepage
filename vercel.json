{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "_comment_rewrites": "Serve the two already-built sister sites as PATHS OF THIS DOMAIN instead of separate vercel.app hosts, so their content counts toward siriai.co.kr (sitelink material) rather than toward vercel.app. No new pages were written for this — these deployments already exist and are already linked from the homepage. Paths /business, /portfolio, /media and /_next were all 404 here before, so these rules can only add routes, never shadow an existing one. The last two exist because the portfolio is a Next.js app that requests its assets from absolute roots (/media/..., /_next/...).",
  "rewrites": [
    { "source": "/business", "destination": "https://siriai-business.vercel.app/" },
    { "source": "/business/:path*", "destination": "https://siriai-business.vercel.app/:path*" },
    { "source": "/support.js", "destination": "https://siriai-business.vercel.app/support.js" },
    { "source": "/image-slot.js", "destination": "https://siriai-business.vercel.app/image-slot.js" },
    { "source": "/portfolio", "destination": "https://siriai-portfolio.vercel.app/" },
    { "source": "/portfolio/:path*", "destination": "https://siriai-portfolio.vercel.app/:path*" },
    { "source": "/media/:path*", "destination": "https://siriai-portfolio.vercel.app/media/:path*" },
    { "source": "/_next/:path*", "destination": "https://siriai-portfolio.vercel.app/_next/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
